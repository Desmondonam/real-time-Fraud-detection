# Copy to .env. Used by docker compose (interpolation) and by the Python
# scripts when run on the host (python-dotenv).

# Credentials for the Postgres container (and for host scripts connecting to it)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=fraud_detection

# Host-side connection, for running scripts outside Docker.
# The compose Postgres is published on 5433 to avoid clashing with a local install.
DB_HOST=localhost
DB_PORT=5433
