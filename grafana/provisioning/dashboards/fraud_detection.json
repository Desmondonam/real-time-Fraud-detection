          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '10s'), percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS \"p50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS \"p95\" FROM scored_transactions WHERE $__timeFilter(scored_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
