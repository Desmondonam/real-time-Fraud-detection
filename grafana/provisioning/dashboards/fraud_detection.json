          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '10s'), COUNT(*) AS \"Events\", COUNT(*) FILTER (WHERE is_high_risk) AS \"Alerts\" FROM scored_transactions WHERE $__timeFilter(scored_at) GROUP BY 1 ORDER BY 1",
