      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "fraud_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT scored_at AS \"Scored at\", txn_id AS \"Txn\", to_char(make_interval(secs => event_time_sec), 'HH24:MI:SS') AS \"Dataset time\", ROUND(amount::numeric, 2) AS \"Amount\", ROUND(rule_score::numeric, 3) AS \"Rule\", ROUND(if_score::numeric, 3) AS \"IF\", ROUND(combined_score::numeric, 3) AS \"Score\", split AS \"Window\", is_confirmed_fraud AS \"Confirmed fraud\" FROM fraud_alerts ORDER BY scored_at DESC, txn_id DESC LIMIT 100",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "fraud_postgres"
      },
      "description": "Only the 'test' row is out-of-sample. 'fit' events were used to train the model and look better than reality.",
      "id": 10,
      "type": "table",
      "title": "Live alert precision by window",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "fraud_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT split AS \"Window\", COUNT(*) AS \"Alerts\", COUNT(*) FILTER (WHERE is_confirmed_fraud) AS \"Fraud\", ROUND(100.0 * COUNT(*) FILTER (WHERE is_confirmed_fraud) / NULLIF(COUNT(*), 0), 1) AS \"Precision %\" FROM fraud_alerts GROUP BY split ORDER BY array_position(ARRAY['fit','tune','test'], split)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "fraud_postgres"
      },
      "description": "Offline metrics from the time-based split: fit (60%) / tune (20%) / test (20%). Report the 'test' row.",
      "id": 11,
      "type": "table",
      "title": "Held-out evaluation (latest model)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "fraud_postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT split AS \"Window\", n_rows AS \"Rows\", fraud_rows AS \"Fraud\", roc_auc AS \"ROC-AUC\", pr_auc AS \"PR-AUC\", alert_precision AS \"Precision\", recall AS \"Recall\", f1 AS \"F1\", ROUND(threshold::numeric, 4) AS \"Threshold\", model_version AS \"Model\" FROM model_metrics WHERE model_version = (SELECT model_version FROM model_metrics ORDER BY recorded_at DESC LIMIT 1) ORDER BY array_position(ARRAY['fit','tune','test'], split)",
          "refId": "A"
        }
      ]
    },
